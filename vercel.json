{
  "functions": {
    "api/admin-page.js": {
      "includeFiles": "admin.html"
    }
  },
  "routes": [
    {
      "src": "^/index\\.html$",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "^/admin\\.html$",
      "dest": "/api/admin-page"
    },
    {
      "src": "^/api/business-cards$",
      "dest": "/api/crew-roster?businessCards=1"
    },
    {
      "handle": "filesystem"
    }
  ],
  "crons": [
    {
      "path": "/api/storage-cleanup",
      "schedule": "0 3 * * *"
    }
  ]
}
